{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/send-notifications.js": {
      "maxDuration": 300
    },
    "api/sync-matches.js": {
      "maxDuration": 60
    },
    "api/sync-live.js": {
      "maxDuration": 60
    },
    "api/delete-account.js": {
      "maxDuration": 30
    },
    "api/admin-close-account.js": {
      "maxDuration": 30
    }
  },
  "regions": ["dub1"],
  "rewrites": [
    {
      "source": "/",
      "has": [
        { "type": "query", "key": "liga" },
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(facebookexternalhit|facebot|whatsapp|twitterbot|slackbot|discordbot|telegrambot|linkedinbot|redditbot|pinterest|skypeuripreview|applebot).*"
        }
      ],
      "destination": "/api/invite-preview"
    },
    {
      "source": "/",
      "has": [
        { "type": "query", "key": "join" },
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(facebookexternalhit|facebot|whatsapp|twitterbot|slackbot|discordbot|telegrambot|linkedinbot|redditbot|pinterest|skypeuripreview|applebot).*"
        }
      ],
      "destination": "/api/invite-preview"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "font-src 'self'" }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
